# Frontend (Vite) - safe to expose
VITE_CLERK_PUBLISHABLE_KEY=

# Pages Functions values: put these in .dev.vars locally and configure them in Cloudflare Pages
DATABASE_URL=
CLERK_SECRET_KEY=
RESEND_API_KEY=
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
PUBLIC_SITE_URL=https://autoacezambia.pages.dev
EMAIL_FROM=Autoace Zambia <onboarding@resend.dev>

# Dashboard access: comma-separated admin emails (set in Cloudflare, NOT committed)
ADMIN_EMAILS=
# Optional: random text used to hash visitor IPs for rate limiting
IP_SALT=
