# Frontend (Vite) - safe to expose
VITE_CLERK_PUBLISHABLE_KEY=

# Pages Functions secrets: put these in .dev.vars locally,
# and add them in Cloudflare Pages > Settings > Variables and Secrets for production
DATABASE_URL=
CLERK_SECRET_KEY=
RESEND_API_KEY=
EMAIL_FROM=Autoace Zambia <onboarding@resend.dev>

# Dashboard access: comma-separated admin emails (set in Cloudflare, NOT committed)
ADMIN_EMAILS=
# Optional: random text used to hash visitor IPs for rate limiting
IP_SALT=
